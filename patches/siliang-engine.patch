+    std::vector<uint32_t> physical_slot_count(model.layers.size(), 0);
+    std::vector<uint32_t> exchange_slot_first(model.layers.size(), 0);
+    std::vector<uint32_t> exchange_slot_count(model.layers.size(), 0);
