+
+    ggml_backend_cuda_context * context = nullptr;
+    const enum ggml_backend_cuda_siliang_status status =
+        ggml_backend_cuda_siliang_get_context(backend, &context);
+    if (status != GGML_BACKEND_CUDA_SILIANG_STATUS_SUCCESS) {
