+    if (error != cudaSuccess) {
+        (void) cudaGetLastError();
+        return GGML_BACKEND_CUDA_SILIANG_STATUS_CUDA_ERROR;
+    }
+    return GGML_BACKEND_CUDA_SILIANG_STATUS_SUCCESS;
+}
